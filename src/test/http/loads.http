# First run simulation.http and log in as loader through authentication.http.
# Keep simFlightNumber and simDate from that simulation; the ULDs must have been consumed.
# Placement/check/finalisation rules and the loading window are enforced by Load Planning.

### Read the booked ULDs (repeat until both cargo messages have been processed)
GET {{baseUrl}}/api/loads/{{simFlightNumber}}/{{simDate}}/BRU
Authorization: Bearer {{accessToken}}

> {% client.test("Both ULDs are booked", function () { client.assert(response.status === 200 && response.body.ulds.length === 2); }); %}

### Read the floor plan, door, loading window and offloading blockers
GET {{baseUrl}}/api/loads/{{simFlightNumber}}/{{simDate}}/BRU/plan
Authorization: Bearer {{accessToken}}

> {% client.test("Floor plan is available", function () { client.assert(response.status === 200 && response.body.floorPlan.doorPosition === "RL"); }); %}

### Place the left ULD
PUT {{baseUrl}}/api/loads/{{simFlightNumber}}/{{simDate}}/BRU/placements/AKE73001R7
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"position":"CL"}

> {% client.test("Left ULD is placed", function () { client.assert(response.status === 200); }); %}

### Place the right ULD
PUT {{baseUrl}}/api/loads/{{simFlightNumber}}/{{simDate}}/BRU/placements/AKE73002R7
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"position":"CR"}

> {% client.test("Right ULD is placed", function () { client.assert(response.status === 200); }); %}

### Move the right ULD atomically; checks run again automatically
PATCH {{baseUrl}}/api/loads/{{simFlightNumber}}/{{simDate}}/BRU/placements/AKE73002R7
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"position":"DR"}

> {% client.test("ULD is moved and checks are refreshed", function () { client.assert(response.status === 200 && response.body.checks.length === 3); }); %}

### Remove a placement; the ULD remains booked
DELETE {{baseUrl}}/api/loads/{{simFlightNumber}}/{{simDate}}/BRU/placements/AKE73002R7
Authorization: Bearer {{accessToken}}

> {% client.test("Placement is removed", function () { client.assert(response.status === 200); }); %}

### Restore the right placement before checking and finalising
PUT {{baseUrl}}/api/loads/{{simFlightNumber}}/{{simDate}}/BRU/placements/AKE73002R7
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"position":"CR"}

> {% client.test("Right placement is restored", function () { client.assert(response.status === 200); }); %}

### Run the existing load checks on demand
POST {{baseUrl}}/api/loads/{{simFlightNumber}}/{{simDate}}/BRU/checks
Authorization: Bearer {{accessToken}}

> {% client.test("Load checks are returned", function () { client.assert(response.status === 200 && response.body.checks.length === 3); }); %}

### Finalise once; failed hard checks still refuse finalisation
POST {{baseUrl}}/api/loads/{{simFlightNumber}}/{{simDate}}/BRU/finalisation
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"confirmWarnings":false}

> {% client.test("Load is final", function () { client.assert(response.status === 200 && response.body.finalised); }); %}

### Observe the existing CPM flow updating Flight Operations (repeat until finalLoadReceived is true)
GET {{baseUrl}}/api/flights/{{simFlightNumber}}/{{simDate}}/BRU
Authorization: Bearer {{accessToken}}

> {% client.test("Final load was processed", function () { client.assert(response.status === 200 && response.body.finalLoadReceived); }); %}
